# Copia este archivo a .env y ajusta los valores en tu equipo.
# Los valores de aquí son solo para desarrollo local.

# PostgreSQL
POSTGRES_USER=entradas
POSTGRES_PASSWORD=cambia-esto-en-local
POSTGRES_DB=entradas

# RabbitMQ
RABBITMQ_USER=entradas
RABBITMQ_PASSWORD=cambia-esto-en-local

# Secretos de los tokens (JWT y QR). Deben ser largos y privados.
JWT_SECRET=cambia-esto-por-32-caracteres-o-mas
QR_SECRET=cambia-esto-por-otros-32-caracteres

# Cookie de sesión. En local va en false porque no hay HTTPS.
COOKIE_SECURE=false

# Usuarios de prueba que crea el seed
SEED_ORGANIZADOR_CORREO=organizador@entradas.dev
SEED_VALIDADOR_CORREO=validador@entradas.dev
SEED_PASSWORD=Demo1234!

# Puertos que se publican en 127.0.0.1
WEB_PORT=8080
MAILPIT_UI_PORT=8025
RABBITMQ_UI_PORT=15672
